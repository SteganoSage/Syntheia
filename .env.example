# OpenAI / Gemini API Keys (For baseline evaluation and reasoning)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Weights & Biases (For ML experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=syntheia-fintech-agents

# Hugging Face (For downloading base models & sharing fine-tuned checkpoints)
HF_TOKEN=your_huggingface_token_here

# App Configuration
APP_ENV=development
CHROMA_PERSIST_DIRECTORY=data/vector_store

# LLM tiers (Day 12) -- one wrapper, switched by OLLAMA_HOST.
# Leave these at the local defaults for dev; override the host for the cloud
# tier (the tunnel URL changes on every Colab restart, so never commit one).
#   local   OLLAMA_HOST=http://localhost:11434  OLLAMA_MODEL=llama3.2:3b   NUM_CTX=4096
#   cloud   OLLAMA_HOST=https://xxx.trycloudflare.com  OLLAMA_MODEL=llama3.1:8b  NUM_CTX=8192
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# 4096 is a measured ceiling on a 4GB card: at 8192 the model grows 2.3->3.08 GB
# and spills to system RAM. Raise it only against the cloud tier.
OLLAMA_NUM_CTX=4096
# LLM_PROVIDER=ollama|gemini|openai  # omit to auto-detect (Ollama first)
